# Application
APP_NAME=Document AI Assistant
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_FILE=data/maintenance_ai.db

# Vector Database (Qdrant)
QDRANT_MODE=local
QDRANT_PATH=qdrant_data

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks
QDRANT_VECTOR_DISTANCE=cosine

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

GENERAL_LLM=qwen3:8b
CLASSIFICATION_LLM=qwen3:8b
QUESTION_GENERATION_LLM=qwen3:8b
EXTRACTION_LLM=qwen3:8b
ANSWER_GENERATION_LLM=qwen3:8b
# ANSWER_GENERATION_TEMPERATURE=0.2
# ANSWER_GENERATION_NUM_CTX=8192
# CAPTURE_ANSWER_PROMPT_TEXT=false

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_PROVIDER=bge
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OCR
# Docling OCR runs inside PDF conversion.
# Provider OCR runs after normalization for asset/page/region recovery.
ENABLE_PROVIDER_OCR=true
OCR_PROVIDER=paddleocr
OCR_ASSET_ENABLED=true
OCR_PAGE_FALLBACK_ENABLED=false
OCR_REGION_FALLBACK_ENABLED=false
OCR_MAX_PAGES_PER_DOCUMENT=5
OCR_MAX_REGIONS_PER_PAGE=2
OCR_MIN_TEXT_CHARS_PER_PAGE=120
OCR_MIN_TEXT_DENSITY=0.0025
OCR_MIN_IMAGE_AREA_RATIO=0.35
OCR_PAGE_RENDER_DPI=150
OCR_TIMEOUT_SECONDS=30
OCR_MIN_CONFIDENCE=0.5
OCR_ATTACH_LOW_CONFIDENCE_TEXT=false
OCR_OUTPUT_DIR=outputs/debug_ocr
OCR_TRACE_ENABLED=false
OCR_FAIL_FAST=false

# Storage Paths
PROJECT_ROOT=
DATA_DIR=data
INPUT_DIR=data/input
OUTPUT_DIR=outputs
PARSED_OUTPUT_DIR=outputs/parsed
IMAGE_OUTPUT_DIR=outputs/images
EXPORT_OUTPUT_DIR=outputs/exports
EVALUATION_OUTPUT_DIR=outputs/evaluation

LOG_DIR=outputs/logs

# Ingestion
INGESTION_RUNTIME_PROFILE=auto
MAX_FILE_SIZE_MB=200
MAX_PDF_PAGES=5000

ENABLE_IMAGE_EXTRACTION=true
ENABLE_TABLE_EXTRACTION=true
ENABLE_QUESTION_GENERATION=true
ENABLE_ANSWER_GENERATION=false

MAX_CHUNK_TOKENS=1000
CHUNK_OVERLAP=150
MIN_SECTION_TEXT_LENGTH=150

# Chunking
MAX_CHUNK_TOKENS=1000
CHUNK_OVERLAP=150
MIN_SECTION_TEXT_LENGTH=150

# Classification
CLASSIFICATION_ENABLED=true
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_STORE_REASONING=true
CLASSIFICATION_ALLOW_RECLASSIFICATION=true
CLASSIFICATION_USE_RULES=true
CLASSIFICATION_USE_LLM=true
CLASSIFICATION_USE_CACHE=true
CLASSIFICATION_MAX_TEXT_LENGTH=12000
CLASSIFICATION_STRONG_MODEL_THRESHOLD=0.80
CLASSIFICATION_STRONG_STRUCTURAL_THRESHOLD=0.75
CLASSIFICATION_WEAK_SIGNAL_THRESHOLD=0.55
CHUNK_CLASSIFICATION_LLM=qwen3:8b
# Enable LLM reclassification for GENERAL/UNKNOWN chunks during ingestion
CHUNK_TYPE_CLASSIFICATION_ENABLED=false
DOCUMENT_TYPES=manual,datasheet,drawing,certificate,report,unknown

# Duplicate Detection
ENABLE_FILE_HASH_CHECK=true
ENABLE_CONTENT_HASH_CHECK=true

CONTENT_HASH_NORMALIZE_TEXT=true

# Identifier Extraction
ENABLE_IDENTIFIER_EXTRACTION=true
IDENTIFIER_MIN_LENGTH=3

# Question Generation
MAX_GENERATED_QUESTIONS_PER_CHUNK=5
QUESTION_GENERATION_CONFIDENCE_THRESHOLD=0.70

# Retrieval
RETRIEVAL_MIN_SCORE=0.50
RETRIEVAL_RELEVANCE_SCORE_THRESHOLD=0.40
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_MAX_CONTEXT_CHUNKS=8
RETRIEVAL_CONTEXT_TOKEN_BUDGET=900

ENABLE_DENSE_RETRIEVAL=true
ENABLE_KEYWORD_RETRIEVAL=true
ENABLE_SQL_RETRIEVAL=true
# When true, dense (Qdrant) search hard-filters to chunks whose identifier_values
# payload matches a detected identifier in the query. Off by default because it
# is a hard filter (excludes non-matching chunks) and has not been validated
# against the retrieval benchmark yet.
ENABLE_DENSE_IDENTIFIER_FILTER=false

DENSE_RETRIEVAL_TOP_K=10
KEYWORD_RETRIEVAL_TOP_K=10
SQL_RETRIEVAL_TOP_K=10

FINAL_RETRIEVAL_TOP_K=5

# Agent
AGENT_ENABLED=true

AGENT_MAX_TOOL_CALLS=3

AGENT_ALLOW_DOCUMENT_TOOLS=true
AGENT_ALLOW_RETRIEVAL_TOOLS=true
AGENT_ALLOW_EXTRACTION_TOOLS=true

# LangGraph
LANGGRAPH_ENABLED=true
LANGGRAPH_CHECKPOINTING=false
LANGGRAPH_MAX_STEPS=20

# Memory
ENABLE_SHORT_TERM_MEMORY=true
ENABLE_LONG_TERM_MEMORY=true

MAX_CONVERSATION_MESSAGES=20

# Extraction
EXTRACTION_ENABLED=true
EXTRACTION_CONFIDENCE_THRESHOLD=0.70
EXTRACTION_REQUIRE_HUMAN_REVIEW=true
# EXTRACTION_MAX_CHUNKS_PER_BATCH=8
# EXTRACTION_MAX_CHARS_PER_BATCH=8000
# EXTRACTION_ALLOW_PARTIAL_BATCHES=true
# EXTRACTION_MAX_ATTEMPTS=2
# EXTRACTION_TEMPERATURE=0.0
# EXTRACTION_JSON_MODE=true
# EXTRACTION_CANDIDATE_ROUTER_ENABLED=false
# EXTRACTION_CANDIDATE_NARROWING_ENABLED=false
# SEMANTIC_LINKING_ENABLED=false

# Guardrails
MIN_EVIDENCE_CHUNKS=2
REQUIRE_CITATIONS=true
ANSWER_MIN_CLAIM_SUPPORT_SCORE=0.60



# Validation
VALIDATION_ENABLED=true
FAIL_ON_VALIDATION_ERROR=false

# Events
EVENTS_ENABLED=true

# Evaluation
EVALUATION_ENABLED=true
EVALUATION_DATASET_PATH=data/fixtures/evaluation_dataset.json

# Docling
# Keep Docling OCR off by default when provider OCR is handling targeted fallback.
DOCLING_PDF_BACKEND=pypdfium2
DOCLING_ACCELERATOR_DEVICE=auto
DOCLING_IMAGES_SCALE=1
DOCLING_NUM_THREADS=2
DOCLING_ENABLE_TABLE_STRUCTURE=true
DOCLING_ENABLE_OCR=false
DOCLING_LAYOUT_BATCH_SIZE=2
DOCLING_TABLE_BATCH_SIZE=1
DOCLING_OCR_BATCH_SIZE=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=outputs/logs/application.log

LOG_ROTATION_SIZE_MB=10
LOG_BACKUP_COUNT=5

LOG_CONSOLE_ENABLED=true
