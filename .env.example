# Database
DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_FILE=data/maintenance_ai.db

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=document_chunks

# Ollama qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
GENERAL_LLM=qwen2.5:3b
CLASSIFICATION_LLM=qwen2.5:3b
CHUNK_CLASSIFICATION_LLM=qwen2.5:3b
QUESTION_GENERATION_LLM=qwen2.5:3b
EXTRACTION_LLM=qwen2.5:3b
ANSWER_GENERATION_LLM=qwen2.5:3b
PLANNING_LLM=qwen2.5:3b

ANSWER_GENERATION_TEMPERATURE=0.2
ANSWER_GENERATION_NUM_CTX=8192
CAPTURE_ANSWER_PROMPT_TEXT=false

# Embeddings | provider = bge|ollama

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=bge
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_SEQUENCE_TOKENS=512

# OCR
# Docling OCR runs inside PDF conversion.
# Provider OCR runs after normalization for asset/page/region recovery.
ENABLE_PROVIDER_OCR=false
OCR_PROVIDER=paddleocr
OCR_ASSET_ENABLED=true
OCR_PAGE_FALLBACK_ENABLED=true
OCR_REGION_FALLBACK_ENABLED=true
OCR_MAX_PAGES_PER_DOCUMENT=5
OCR_MAX_REGIONS_PER_PAGE=2
OCR_MIN_TEXT_CHARS_PER_PAGE=120
OCR_MIN_TEXT_DENSITY=0.0025
OCR_MIN_IMAGE_AREA_RATIO=0.35
OCR_PAGE_RENDER_DPI=150
OCR_TIMEOUT_SECONDS=30
OCR_MIN_CONFIDENCE=0.5
OCR_ATTACH_LOW_CONFIDENCE_TEXT=false
OCR_OUTPUT_DIR=outputs/debug_ocr
OCR_TRACE_ENABLED=true
OCR_FAIL_FAST=false

# Ingestion
INGESTION_RUNTIME_PROFILE=auto
MAX_FILE_SIZE_MB=200
MAX_PDF_PAGES=5000
ENABLE_QUESTION_GENERATION=false

PARSE_TIMEOUT_SECONDS=3600
LOW_CONFIDENCE_PARSE_THRESHOLD=0.5

# Question Generation
MAX_GENERATED_QUESTIONS_PER_CHUNK=5

# Chunking
# Leave global size overrides unset so src/config/chunking/*.yaml policies apply.
# MAX_CHUNK_TOKENS=300
# CHUNK_OVERLAP=60
# MIN_SECTION_TEXT_LENGTH=20
CHUNK_TOKEN_COUNTER_PROVIDER=transformer
CHUNK_TOKENIZER_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENIZER_LOCAL_ONLY=true
CHUNK_USE_LAYOUT_FRONT_MATTER_SIGNAL=false
CHUNK_CROSS_REFERENCE_DETECTION_ENABLED=true
CHUNK_CROSS_REFERENCE_PDF_LINKS_ENABLED=true


CHUNK_TYPE_CLASSIFICATION_ENABLED=false
CHUNK_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70

# Classification
CLASSIFICATION_ENABLED=false
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_STORE_REASONING=true
CLASSIFICATION_ALLOW_RECLASSIFICATION=true
CLASSIFICATION_USE_CACHE=true
CLASSIFICATION_MAX_TEXT_LENGTH=12000
CLASSIFICATION_STRONG_MODEL_THRESHOLD=0.80
CLASSIFICATION_STRONG_STRUCTURAL_THRESHOLD=0.75
CLASSIFICATION_WEAK_SIGNAL_THRESHOLD=0.55

#prompt
PROMPT_CONTEXT_MAX_ITEMS_PER_ARRAY=20
PROMPT_CONTEXT_INCLUDE_SOURCE_TABLE_ROWS=false
PROMPT_CONTEXT_MAX_TABLE_ROWS_PER_SOURCE=20

# Retrieval
RETRIEVAL_MIN_SCORE=0.50
RETRIEVAL_RELEVANCE_SCORE_THRESHOLD=0.40
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_MAX_CONTEXT_CHUNKS=8
RETRIEVAL_CONTEXT_TOKEN_BUDGET=900
RETRIEVAL_CROSS_REFERENCE_EXPANSION_ENABLED=true

# Guardrails
MIN_EVIDENCE_CHUNKS=2
REQUIRE_CITATIONS=true
ANSWER_MIN_CLAIM_SUPPORT_SCORE=0.60

# Answer Generation
ENABLE_ANSWER_GENERATION=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=outputs/logs/application.log
LOG_ROTATION_SIZE_MB=10
LOG_BACKUP_COUNT=5
LOG_CONSOLE_ENABLED=true

# Storage Paths
DATA_DIR=data
INPUT_DIR=data/input
OUTPUT_DIR=outputs
PARSED_OUTPUT_DIR=outputs/parsed
IMAGE_OUTPUT_DIR=outputs/images
EXPORT_OUTPUT_DIR=outputs/exports
EVALUATION_OUTPUT_DIR=outputs/evaluation
LOG_DIR=outputs/logs

# Docling
# Keep Docling OCR off by default when provider OCR is handling targeted fallback.
DOCLING_PDF_BACKEND=docling_parse   # docling_parse, pypdfium2 , threaded_docling_parse
DOCLING_ACCELERATOR_DEVICE=cuda    #auto
DOCLING_IMAGES_SCALE=2
DOCLING_NUM_THREADS=8
DOCLING_ENABLE_TABLE_STRUCTURE=true
DOCLING_TABLE_STRUCTURE_MODE=accurate
DOCLING_TABLE_CELL_MATCHING=true
DOCLING_ENABLE_OCR=false
DOCLING_LAYOUT_BATCH_SIZE=2
DOCLING_TABLE_BATCH_SIZE=1
DOCLING_OCR_BATCH_SIZE=1


# Duplicate Detection
ENABLE_FILE_HASH_CHECK=true
ENABLE_CONTENT_HASH_CHECK=true

# Identifiers
ENABLE_IDENTIFIER_EXTRACTION=true
IDENTIFIER_MIN_LENGTH=3
EXTRACTION_MAX_CHUNKS_PER_BATCH=18
EXTRACTION_MAX_CHARS_PER_BATCH=8000
EXTRACTION_ALLOW_PARTIAL_BATCHES=true
EXTRACTION_FAILURE_PREVIEW_CHARS=2000
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_JSON_MODE=true

# Hybrid Retrieval
ENABLE_DENSE_RETRIEVAL=true
ENABLE_DENSE_IDENTIFIER_FILTER=true
ENABLE_KEYWORD_RETRIEVAL=true
ENABLE_SQL_RETRIEVAL=true
DENSE_RETRIEVAL_TOP_K=20
KEYWORD_RETRIEVAL_TOP_K=20
SQL_RETRIEVAL_TOP_K=20
FINAL_RETRIEVAL_TOP_K=5

# LangGraph
LANGGRAPH_ENABLED=true
LANGGRAPH_MAX_STEPS=20
LANGGRAPH_LLM_PLANNING_ENABLED=true
LANGGRAPH_REFLECTION_ENABLED=true
LANGGRAPH_SHOW_REFLECTION=true
LANGGRAPH_RETRIEVAL_STRATEGY_ENABLED=true
LANGGRAPH_LLM_RETRIEVAL_STRATEGY_ENABLED=true
LANGGRAPH_SHOW_RETRIEVAL_STRATEGY=true
LANGGRAPH_DEEP_RESEARCH_ENABLED=true
LANGGRAPH_LLM_RESEARCH_PLANNING_ENABLED=true
LANGGRAPH_SHOW_RESEARCH_PLAN=true

# Memory
ENABLE_SHORT_TERM_MEMORY=true
MAX_CONVERSATION_MESSAGES=20

# Extraction
EXTRACTION_ENABLED=true
EXTRACTION_CONFIDENCE_THRESHOLD=0.70
EXTRACTION_REQUIRE_HUMAN_REVIEW=true
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_CANDIDATE_ROUTER_ENABLED=true
EXTRACTION_CANDIDATE_NARROWING_ENABLED=true
SEMANTIC_LINKING_ENABLED=true

# Qdrant Mode
QDRANT_MODE=local
QDRANT_PATH=qdrant_data
QDRANT_VECTOR_DISTANCE=cosine
